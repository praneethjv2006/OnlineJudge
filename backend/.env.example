PORT=5000
MONGO_URI=mongodb://localhost:27017/onlinejudge
# Local frontend origin. In Render, use the exact deployed frontend origin.
# For multiple environments: CLIENT_URLS=https://app.example.com,https://staging.example.com
# For Render, set this to the public compiler service URL; localhost is local/Docker only.
COMPILER_SERVICE_URL=http://localhost:5001
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
GROQ_API_KEY=your_groq_api_key_here
# Add other secrets here
