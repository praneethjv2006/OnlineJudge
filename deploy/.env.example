# Public names. Add API_DOMAIN as the Tunnel's public hostname in Cloudflare.
API_DOMAIN=api.example.com
CLIENT_URL=https://app.example.com

# Cloudflare Dashboard > Networking > Tunnels > <your tunnel> > Add a replica.
# Treat this as a credential: it gives its holder permission to run the tunnel.
TUNNEL_TOKEN=

# Paste your Atlas connection string. Never commit the real .env file.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/onlinejudge?retryWrites=true&w=majority

# Create long random values: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Only required if you use the existing AI problem-generation/review feature.
GROQ_API_KEY=
